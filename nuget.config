<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      The test site installs the package the way a consuming site does: from the nupkg, not from a
      project reference, so the static web assets and the composer are exercised as shipped.
      Pack before restoring the test site (see README, "Test site").
    -->
    <add key="local-artifacts" value="artifacts" />
  </packageSources>
</configuration>
