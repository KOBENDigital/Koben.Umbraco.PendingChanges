{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Koben.PendingChanges",
  "id": "Koben.PendingChanges",
  "version": "0.3.0",
  "allowTelemetry": false,
  "extensions": [
    {
      "type": "workspaceContext",
      "alias": "Koben.PendingChanges.WorkspaceContext",
      "name": "Pending Changes Workspace Context",
      "api": "/App_Plugins/Koben.PendingChanges/pending-changes.js",
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Document"
        }
      ]
    },
    {
      "type": "workspaceContext",
      "alias": "Koben.PendingChanges.BlockWorkspaceContext",
      "name": "Pending Changes Block Workspace Context",
      "api": "/App_Plugins/Koben.PendingChanges/pending-changes.js",
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Block"
        }
      ]
    },
    {
      "type": "entitySign",
      "kind": "icon",
      "alias": "Koben.PendingChanges.EntitySign.Document",
      "name": "Pending Changes Document Entity Sign",
      "element": "/App_Plugins/Koben.PendingChanges/pending-changes.js",
      "forEntityTypes": ["document"],
      "forEntityFlags": ["Umb.PendingChanges"],
      "overwrites": "Umb.EntitySign.Document.HasPendingChanges",
      "weight": 1100,
      "meta": {
        "iconName": "icon-edit",
        "label": "#content_unpublishedChanges"
      }
    }
  ]
}
